# ---- General ---------------------------------------------------------------
ENVIRONMENT=development            # set to "production" to disable /docs and enable HSTS
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HEADERS=false          # true only behind a proxy you control (uses X-Forwarded-For)

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=12
MAX_IMAGE_SIDE=1536                # images are resized + re-encoded (EXIF stripped) before sending
MIN_IMAGE_SIDE=256

# ---- Try-on provider -------------------------------------------------------
# none | generic | replicate
TRYON_PROVIDER=none
TRYON_TIMEOUT_SECONDS=240
TRYON_POLL_INTERVAL_SECONDS=2

# generic: any endpoint implementing docs/PROVIDERS.md "StyleMirror provider protocol v1"
TRYON_API_URL=
TRYON_API_KEY=
TRYON_STATUS_URL_TEMPLATE=         # e.g. https://your-host/jobs/{job_id}
ALLOW_INSECURE_PROVIDER_URLS=false # true only for a local http:// self-hosted model

# replicate: cuuupid/idm-vton (CC BY-NC-SA 4.0 — NON-COMMERCIAL ONLY)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
REPLICATE_STEPS=30
REPLICATE_SEED=42

# ---- Jobs & abuse prevention ------------------------------------------------
MAX_CONCURRENT_JOBS=4
MAX_ACTIVE_JOBS_PER_CLIENT=2
JOB_RESULT_TTL_SECONDS=1800        # unsaved results are dropped from memory after this
RATE_LIMIT_TRYON_ANONYMOUS_PER_HOUR=5
RATE_LIMIT_TRYON_USER_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ---- Supabase (optional: enables sign-in + private history) -----------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. Never put this in the frontend.
SUPABASE_BUCKET=tryon-results
REQUIRE_AUTH=false                 # recommended true in production
SIGNED_URL_TTL_SECONDS=3600
HISTORY_RETENTION_DAYS=30          # 0 = keep until the user deletes
